# ==================== Security Keys ====================
# 使用以下命令生成随机密钥:
#   openssl rand -hex 32          # SECRET_KEY
#   openssl rand -hex 32          # CRYPTO_KEY_HEX

SECRET_KEY=change_me_to_random_32_hex_chars_here
CRYPTO_KEY_HEX=change_me_to_random_64_hex_chars_here
POSTGRES_PASSWORD=change_me_to_secure_password
MINIO_ACCESS_KEY=minio_admin_user
MINIO_SECRET_KEY=change_me_to_secure_32_char_password

# ==================== Database ====================
DATABASE_URL=postgresql://ollp_user:your_password@db:5432/ollp_db
REDIS_URL=redis://redis:6379/0

# ==================== Network ====================
DOMAIN=localhost
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:80

# ==================== OAuth (可选) ====================
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret

# ==================== Logging ====================
LOG_LEVEL=info
